rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    function isApprovedUser() {
      return isAuthenticated()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isRegistered == true
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.registrationData.validationStatus == "approved";
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isUniqueorgId(orgId, userId) {
      return !exists(/databases/$(database)/documents/users/$(userId)) ||
             get(/databases/$(database)/documents/users/$(userId)).data.registrationData.orgId == orgId ||
             !existsAfter(/databases/$(database)/documents/org_ids/$(orgId));
    }

    // User profiles
    match /users/{userId} {
      // Allow read for authenticated users
      allow read: if isAuthenticated();

      // Allow create for new users (self-registration)
      allow create: if isOwner(userId)
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.isAdmin == false
                    && (!request.resource.data.keys().hasAny(['registrationData']) ||
                        isUniqueorgId(request.resource.data.registrationData.orgId, userId));

      // Allow update for self (except admin fields) or admin users
      allow update: if (isOwner(userId)
                       && request.resource.data.isAdmin == resource.data.isAdmin
                       && (!request.resource.data.keys().hasAny(['registrationData']) ||
                           isUniqueorgId(request.resource.data.registrationData.orgId, userId)))
                    || (isAdmin()
                       && request.resource.data.keys().hasAll(['isAdmin', 'registrationData'])
                       && request.resource.data.registrationData.validationStatus in ['pending', 'approved', 'rejected']);

      // No delete allowed
      allow delete: if false;
    }

    // Admin operations - allow admins to read all user data for validation
    match /users/{userId} {
      allow read: if isAdmin();
    }

    // Blog posts (existing functionality)
    match /posts/{postId} {
      allow read: if true;
      allow create: if isApprovedUser()
                    && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isApprovedUser()
                           && request.auth.uid == resource.data.authorId;
    }

    // Comments subcollection (existing functionality)
    match /posts/{postId}/comments/{commentId} {
      allow read: if true;
      allow create: if isApprovedUser()
                    && request.resource.data.authorId == request.auth.uid
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // Likes (existing functionality)
    match /likes/{likeId} {
      allow read: if true;
      allow create: if isApprovedUser()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.postId is string;
      allow delete: if isApprovedUser()
                    && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    // Ratings (existing functionality)
    match /ratings/{ratingId} {
      allow read: if true;
      allow create: if isApprovedUser()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.postId is string
                    && request.resource.data.stars is int
                    && request.resource.data.stars >= 1
                    && request.resource.data.stars <= 5;
      allow update: if isApprovedUser()
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.stars is int
                    && request.resource.data.stars >= 1
                    && request.resource.data.stars <= 5;
      allow delete: if false;
    }

    // org ID tracking collection to enforce uniqueness
    match /org_ids/{orgId} {
      allow create: if isAuthenticated()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.orgId == orgId;
      allow delete: if isAuthenticated()
                    && resource.data.userId == request.auth.uid;
      allow read: if false;
      allow update: if false;
    }

    // Contact messages
    match /contact_messages/{messageId} {
      // Allow anyone to create contact messages
      allow create: if request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.email is string
                    && request.resource.data.email.size() > 0
                    && request.resource.data.message is string
                    && request.resource.data.message.size() > 0
                    && request.resource.data.status == "unread"
                    && request.resource.data.createdAt is timestamp;

      // Allow admins to read and update contact messages
      allow read, update: if isAdmin();

      // No delete allowed
      allow delete: if false;
    }

    // Custom Forms
    match /forms/{formId} {
      // Allow approved users to read active forms
      allow read: if isApprovedUser()
                  && resource.data.status == "active";

      // Allow admins to manage all forms
      allow read, create, update, delete: if isAdmin();
    }

    // Form Submissions
    match /form_submissions/{submissionId} {
      // Allow approved users to create submissions for their own account
      allow create: if isApprovedUser()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.orgId is string
                    && request.resource.data.phoneNumber is string
                    && request.resource.data.agreedToTerms == true
                    && request.resource.data.submittedAt is timestamp;

      // Allow users to read their own submissions
      allow read: if isAuthenticated()
                  && resource.data.userId == request.auth.uid;

      // Allow admins to read all submissions
      allow read: if isAdmin();

      // No updates or deletes allowed
      allow update:  if isAuthenticated()
                  && resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    // App Settings - Admin only access
    match /app_settings/{settingsId} {
      allow read: if isAuthenticated();
      // Allow admins to read, create, and update settings
      allow create, update: if isAdmin();

      // No delete allowed to prevent accidental removal
      allow delete: if false;
    }
  }
}
